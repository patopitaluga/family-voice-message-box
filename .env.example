TELEGRAM_TOKEN=...
CHAT_ID=...  # chat_id del grupo de Telegram de la familia (p. ej. -100…)
# Opcional (Raspberry Pi) — defaults:
# GPIO_CHIP=gpiochip0  # Pi 2/3/4. En Pi 5 (RP1) suele ser gpiochip4.
# GPIO_RECORD_BUTTON=17
# GPIO_RECORD_LED=27
# GPIO_PLAY_BUTTON=22
# GPIO_PLAY_LED=23
# EVDEV_KEYBOARD=/dev/input/event0  # solo en `npm run start:dev`; si no, se busca *-event-kbd
# ALSA_DEVICE=plughw:1,0  # opcional; si no, se elige un USB de `arecord -l`
# ALSA_RATE=48000  # opcional; si no, se pregunta al micrófono y se prefieren 48000 (Opus)
# ALSA_PLAYBACK_DEVICE=plughw:1,0  # opcional; si no, USB de `aplay -l`
# AUDIO_NORMALIZE=off  # desactiva la normalización de volumen por software (ffmpeg)
# Solo en la Mac, para `npm run update:pi`:
# RASPBERRY_HOST=pi@raspberrypi.local
# RASPBERRY_DIR=family-voice-message-box  # relativo al home de la Pi, o ruta absoluta
# RASPBERRY_SERVICE=family-voice-message-box
